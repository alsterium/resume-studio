{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resume Studio Project v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "title",
    "documentDate",
    "profile",
    "resume",
    "career",
    "templates",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "$ref": "#/definitions/id"
    },
    "title": {
      "$ref": "#/definitions/text"
    },
    "documentDate": {
      "$ref": "#/definitions/date"
    },
    "profile": {
      "$ref": "#/definitions/profile"
    },
    "resume": {
      "$ref": "#/definitions/resume"
    },
    "career": {
      "$ref": "#/definitions/career"
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resume",
        "career"
      ],
      "properties": {
        "resume": {
          "$ref": "#/definitions/template"
        },
        "career": {
          "$ref": "#/definitions/template"
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/asset"
      },
      "maxItems": 4,
      "minItems": 0
    },
    "documentDateMode": {
      "enum": [
        "fixed",
        "today"
      ]
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "text": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "optionalDate": {
      "anyOf": [
        {
          "$ref": "#/definitions/date"
        },
        {
          "const": ""
        }
      ]
    },
    "yearMonth": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2})?$"
    },
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "bold",
            "italic"
          ]
        }
      }
    },
    "inline": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "maxLength": 65536,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
              "minLength": 1
            },
            "marks": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/mark"
              },
              "maxItems": 2,
              "minItems": 0,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "hardBreak"
            }
          }
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/inline"
          },
          "maxItems": 10000,
          "minItems": 0
        }
      }
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ],
      "properties": {
        "type": {
          "const": "listItem"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/block"
          },
          "maxItems": 10000,
          "minItems": 1
        }
      }
    },
    "list": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "const": "bulletList"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/listItem"
              },
              "maxItems": 10000,
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "const": "orderedList"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/listItem"
              },
              "maxItems": 10000,
              "minItems": 1
            },
            "attrs": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "type": {
                  "type": "null"
                }
              }
            }
          }
        }
      ]
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/definitions/paragraph"
        },
        {
          "$ref": "#/definitions/list"
        }
      ]
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "doc"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/block"
          },
          "maxItems": 10000,
          "minItems": 0
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postalCode",
        "address",
        "addressKana",
        "phone",
        "email"
      ],
      "properties": {
        "postalCode": {
          "$ref": "#/definitions/text"
        },
        "address": {
          "$ref": "#/definitions/text"
        },
        "addressKana": {
          "$ref": "#/definitions/text"
        },
        "phone": {
          "$ref": "#/definitions/text"
        },
        "email": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "nameKana",
        "birthDate",
        "postalCode",
        "address",
        "addressKana",
        "phone",
        "email",
        "photoAssetId"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/text"
        },
        "nameKana": {
          "$ref": "#/definitions/text"
        },
        "birthDate": {
          "$ref": "#/definitions/optionalDate"
        },
        "postalCode": {
          "$ref": "#/definitions/text"
        },
        "address": {
          "$ref": "#/definitions/text"
        },
        "addressKana": {
          "$ref": "#/definitions/text"
        },
        "phone": {
          "$ref": "#/definitions/text"
        },
        "email": {
          "$ref": "#/definitions/text"
        },
        "photoAssetId": {
          "anyOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "genderLabel": {
          "$ref": "#/definitions/text"
        },
        "alternateContact": {
          "$ref": "#/definitions/contact"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "yearMonth",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "yearMonth": {
          "$ref": "#/definitions/yearMonth"
        },
        "text": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "education",
        "employment",
        "qualifications",
        "motivation",
        "preferences"
      ],
      "properties": {
        "education": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/row"
          },
          "maxItems": 200,
          "minItems": 0
        },
        "employment": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/row"
          },
          "maxItems": 200,
          "minItems": 0
        },
        "qualifications": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/row"
          },
          "maxItems": 200,
          "minItems": 0
        },
        "motivation": {
          "$ref": "#/definitions/body"
        },
        "preferences": {
          "$ref": "#/definitions/body"
        }
      }
    },
    "companyOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "business": {
          "$ref": "#/definitions/text"
        },
        "capital": {
          "$ref": "#/definitions/text"
        },
        "employees": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "startYearMonth",
        "endYearMonth",
        "overview",
        "phases",
        "responsibilities",
        "achievements",
        "teamSize",
        "languages",
        "technologies"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/text"
        },
        "startYearMonth": {
          "$ref": "#/definitions/yearMonth"
        },
        "endYearMonth": {
          "anyOf": [
            {
              "$ref": "#/definitions/yearMonth"
            },
            {
              "type": "null"
            }
          ]
        },
        "overview": {
          "$ref": "#/definitions/body"
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/text"
          },
          "maxItems": 50,
          "minItems": 0
        },
        "responsibilities": {
          "$ref": "#/definitions/body"
        },
        "achievements": {
          "$ref": "#/definitions/body"
        },
        "teamSize": {
          "$ref": "#/definitions/text"
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/text"
          },
          "maxItems": 50,
          "minItems": 0
        },
        "technologies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/text"
          },
          "maxItems": 50,
          "minItems": 0
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^(https?://[^\\s\\u0000-\\u001f\\u007f-\\u009f]+)?$"
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "companyName",
        "startYearMonth",
        "endYearMonth",
        "role",
        "projects"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "companyName": {
          "$ref": "#/definitions/text"
        },
        "startYearMonth": {
          "$ref": "#/definitions/yearMonth"
        },
        "endYearMonth": {
          "anyOf": [
            {
              "$ref": "#/definitions/yearMonth"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/definitions/text"
        },
        "companyOverview": {
          "$ref": "#/definitions/companyOverview"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/project"
          },
          "maxItems": 200,
          "minItems": 0
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "experienceLabel",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "$ref": "#/definitions/text"
        },
        "experienceLabel": {
          "$ref": "#/definitions/text"
        },
        "description": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "career": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "positions",
        "skills",
        "selfPromotion"
      ],
      "properties": {
        "summary": {
          "$ref": "#/definitions/body"
        },
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/position"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/skill"
          },
          "maxItems": 200,
          "minItems": 0
        },
        "selfPromotion": {
          "$ref": "#/definitions/body"
        },
        "qualifications": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/row"
          },
          "maxItems": 200,
          "minItems": 0
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 40
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mediaType",
        "base64"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "mediaType": {
          "enum": [
            "image/jpeg",
            "image/png"
          ]
        },
        "base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 6990508,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
