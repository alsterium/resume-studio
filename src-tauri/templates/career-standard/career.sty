\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{career}[2026/10/06 Resume Studio career]
\RequirePackage[margin=18mm]{geometry}
\RequirePackage[hidelinks,unicode]{hyperref}
\RequirePackage{color}
\pagestyle{empty}
\renewcommand{\familydefault}{\sfdefault}
\renewcommand{\kanjifamilydefault}{\gtdefault}
\setlength{\parindent}{0pt}
\setlength{\parskip}{2mm}
\AtBeginDocument{\fontsize{10.5pt}{17pt}\selectfont\emergencystretch=2em}
\newcommand{\cr@reserve}[1]{\par
  \ifdim\pagegoal<\maxdimen
    \ifdim\dimexpr\pagegoal-\pagetotal\relax<#1\relax\newpage\fi
  \fi}
\newcommand{\cr@dottedRule}{\begingroup\color[gray]{.65}\noindent\hbox to\linewidth{%
  \leaders\hbox{\rule{.8pt}{.3pt}\hskip1.5pt}\hfill}\par\endgroup}
\newcommand{\CareerHeader}[2]{%
  {\fontsize{18pt}{24pt}\selectfont\bfseries 職務経歴書}\par\nobreak
  \hrule height.7pt\kern1.2pt\hrule height.3pt\nobreak\vspace{2mm}
  \hfill #1\par\nobreak\hfill #2\par}
\newcommand{\CareerSection}[1]{%
  \cr@reserve{4\baselineskip}\addvspace{5mm}
  {\fontsize{14pt}{20pt}\selectfont\bfseries #1}\par\nobreak
  \hrule height.5pt\nobreak\vspace{2mm}}
\newcommand{\CareerCompany}[2]{%
  \cr@reserve{4\baselineskip}\addvspace{4mm}
  \noindent\colorbox[gray]{.92}{\parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
    \textbf{#1}\hfill {\small #2}}}\par\nobreak}
\newcommand{\CareerProjects}{\cr@reserve{4\baselineskip}\textbf{主な実績}\par\nobreak}
\newcommand{\CareerProject}[2]{%
  \cr@reserve{4\baselineskip}\addvspace{3mm}
  \noindent\ensuremath{\diamond}\quad\textbf{#1}\par\nobreak
  {\small\color[gray]{.25}#2}\par\nobreak}
\newcommand{\CareerField}[2]{%
  \cr@reserve{2\baselineskip}\noindent\textbf{【#1】}\quad #2\par}
\newcommand{\CareerBody}[2]{%
  \cr@reserve{3\baselineskip}\noindent\textbf{【#1】}\par\nobreak #2}
\newbox\cr@left
\newbox\cr@right
\newbox\cr@leftSlice
\newbox\cr@rightSlice
\newcommand{\cr@split}[2]{%
  \splittopskip=\topskip\splitmaxdepth=0pt
  \ifdim\dimexpr\ht#1+\dp#1\relax>35mm
    \setbox#2=\vsplit#1 to35mm
  \else\setbox#2=\box#1\fi}
\newcommand{\CareerSkill}[2]{\par\begingroup
  \setbox\cr@left=\vbox{\hsize=.48\linewidth\linewidth=\hsize
    \raggedright\textbf{#1}\par}
  \setbox\cr@right=\vbox{\hsize=.48\linewidth\linewidth=\hsize
    \raggedright #2\par}
  % Bound each row fragment so a long skill cell can cross pages too.
  \loop
    \cr@reserve{2\baselineskip}
    \cr@split{\cr@left}{\cr@leftSlice}\cr@split{\cr@right}{\cr@rightSlice}
    \noindent\hbox to\linewidth{%
      \vtop{\vskip0pt\hsize=.48\linewidth\unvbox\cr@leftSlice}\hfil
      {\color[gray]{.25}\vtop{\vskip0pt\hsize=.48\linewidth\unvbox\cr@rightSlice}}}\par
  \ifdim\dimexpr\ht\cr@left+\dp\cr@left+\ht\cr@right+\dp\cr@right\relax>0pt
  \repeat
  \cr@dottedRule\endgroup}
\newcommand{\CareerURL}[2]{\noindent\textbf{URL}\quad\href{#1}{#2}\par}
