{
  "name": "resume-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint --deny-warnings src tests vite.config.ts vitest.config.ts tools/desktop-e2e.mjs",
    "format": "oxfmt --write src tests vite.config.ts vitest.config.ts tsconfig.json index.html package.json .oxlintrc.json .oxfmtrc.json src-tauri/tauri.conf.json src-tauri/capabilities tools/desktop-e2e.mjs",
    "format:check": "oxfmt --check src tests vite.config.ts vitest.config.ts tsconfig.json index.html package.json .oxlintrc.json .oxfmtrc.json src-tauri/tauri.conf.json src-tauri/capabilities tools/desktop-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "rust:format": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked --all-targets",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "test:tasks": "node --test tools/tests/*.test.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm rust:format:check && pnpm rust:check && pnpm rust:lint && pnpm test:tasks && pnpm test:integration && pnpm test:unit && pnpm rust:test",
    "test:integration": "vitest run tests/integration",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:tex": "cargo test --manifest-path src-tauri/Cargo.toml --locked --features real-tex --test real_tex",
    "build:e2e": "tauri build --debug --features desktop-e2e",
    "test:e2e": "node tools/desktop-e2e.mjs",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "26.1.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "webdriverio": "9.30.1"
  },
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": "10.26.2"
  },
  "packageManager": "pnpm@10.26.2"
}
