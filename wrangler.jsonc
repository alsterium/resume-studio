{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resume-studio-web",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "routes": [{ "pattern": "resume-studio.alsterium.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist-web",
    "not_found_handling": "single-page-application"
  }
}
