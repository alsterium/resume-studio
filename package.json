{
  "name": "resume-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:schemas && vite",
    "build": "pnpm generate:schemas && tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint --deny-warnings src tests vite.config.ts vitest.config.ts tools/desktop-e2e.mjs tools/generate-schema-validator.mjs tools/render-pdf.mjs tools/rename-app.mjs tools/tests/rename-app.test.mjs",
    "format": "oxfmt --write src tests vite.config.ts vitest.config.ts tsconfig.json index.html package.json .oxlintrc.json .oxfmtrc.json src-tauri/tauri.conf.json src-tauri/capabilities tools/desktop-e2e.mjs tools/generate-schema-validator.mjs tools/render-pdf.mjs tools/rename-app.mjs tools/tests/rename-app.test.mjs",
    "format:check": "oxfmt --check src tests vite.config.ts vitest.config.ts tsconfig.json index.html package.json .oxlintrc.json .oxfmtrc.json src-tauri/tauri.conf.json src-tauri/capabilities tools/desktop-e2e.mjs tools/generate-schema-validator.mjs tools/render-pdf.mjs tools/rename-app.mjs tools/tests/rename-app.test.mjs",
    "typecheck": "pnpm generate:schemas && tsc --noEmit",
    "rust:format": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked --all-targets",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "test:tasks": "node --test tools/tests/*.test.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm rust:format:check && pnpm rust:check && pnpm rust:lint && pnpm test:tasks && pnpm test:integration && pnpm test:unit && pnpm rust:test",
    "test:integration": "pnpm generate:schemas && vitest run tests/integration",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:tex": "cargo test --manifest-path src-tauri/Cargo.toml --locked --features real-tex --test real_tex",
    "build:e2e": "tauri build --debug --features desktop-e2e",
    "test:e2e": "node tools/desktop-e2e.mjs",
    "test:unit": "pnpm generate:schemas && vitest run tests/unit",
    "generate:schemas": "node tools/generate-schema-validator.mjs",
    "pdf:render": "node tools/render-pdf.mjs",
    "template:rename": "node tools/rename-app.mjs",
    "dev:web": "pnpm generate:schemas && vite --mode web",
    "build:web": "pnpm generate:schemas && tsc --noEmit && vite build --mode web",
    "preview:web": "vite preview --mode web",
    "deploy:web": "pnpm build:web && wrangler deploy"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "1.52.0",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.14.2",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "webdriverio": "9.30.1",
    "wrangler": "4.113.0"
  },
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": "10.26.2"
  },
  "packageManager": "pnpm@10.26.2"
}
