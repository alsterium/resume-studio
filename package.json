{
  "name": "resume-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint --deny-warnings src vite.config.ts",
    "format": "oxfmt --write src vite.config.ts tsconfig.json index.html package.json .oxlintrc.json .oxfmtrc.json src-tauri/tauri.conf.json",
    "format:check": "oxfmt --check src vite.config.ts tsconfig.json index.html package.json .oxlintrc.json .oxfmtrc.json src-tauri/tauri.conf.json",
    "typecheck": "tsc --noEmit",
    "rust:format": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked --all-targets",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "test:tasks": "node --test tools/tests/*.test.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm rust:format:check && pnpm rust:check && pnpm rust:lint && pnpm test:tasks"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": "10.26.2"
  },
  "packageManager": "pnpm@10.26.2"
}
